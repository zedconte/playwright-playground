{
  "name": "playwright-playground",
  "version": "1.0.0",
  "description": "Playwright framework with self-discovering tests and a Vue coverage dashboard (LLM-assisted development showcase)",
  "scripts": {
    "discover": "tsx framework/discover.ts",
    "test": "npm run dashboard:build --silent && tsx framework/discover.ts --if-stale && playwright test",
    "test:authored": "playwright test --grep-invert @discovered",
    "test:discovered": "playwright test --grep @discovered",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "report": "playwright show-report",
    "dashboard:build": "vite build dashboard --logLevel warn",
    "dashboard:dev": "vite dashboard",
    "typecheck": "tsc -p . && vue-tsc -p dashboard",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit"
  },
  "keywords": [],
  "author": "Raul Ortega",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11",
    "vue": "^3.5.43",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
